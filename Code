module top(
    input btnC,
    input btnU,
    output [6:0] led
);

    ripple ripple1(
        .clk(btnC),
        .reset(btnU),
        .led(led[2:0])
    );

    modulo modulo1(
        .clk(btnC),
        .reset(btnU),
        .led(led[5:3]),
        .divided_clk(led[6])
    );

endmodule


d_flipflop.v

module d_flipflop(
    input D,
    input clk,
    input reset,
    output reg Q,
    output NotQ
);

    initial begin
        Q = 0;
    end

    always @(posedge clk or posedge reset) begin
        if (reset)
            Q <= 1'b0;
        else
            Q <= D;
    end

    assign NotQ = ~Q;

endmodule


t_flipflop.v

module t_flipflop(
    input T,
    input clk,
    input reset,
    output Q,
    output NotQ
);

    wire D;

    assign D = T ^ Q;

    d_flipflop dff1(
        .D(D),
        .clk(clk),
        .Q(Q),
        .NotQ(NotQ),
        .reset(reset)
    );

endmodule



full_adder.v

module full_adder(
    input A,
    input B,
    input Cin,
    output sum,
    output Cout
);

assign sum = A^B^Cin;
assign Cout = (A & B) | (A & Cin) | (B & Cin);

endmodule


ripple.v

module ripple(
    input clk,
    input reset,
    output [2:0] led
);

    t_flipflop tff1(
        .T(1'b1),
        .clk(clk),
        .Q(led[0]),
        .reset(reset)
    );
    
    t_flipflop tff2(
        .T(1'b1),
        .clk(led[0]),
        .Q(led[1]),
        .reset(reset)
    );
    
    t_flipflop tff3(
        .T(1'b1),
        .clk(led[1]),
        .Q(led[2]),
        .reset(reset)
    );
    
endmodule


modulo.v

module modulo(
    input clk,
    input reset,
    output [2:0] led,
    output divided_clk
);

wire [2:0] count;
wire [2:0] next_count;
wire [1:0] carry;
wire terminal_count;
wire [2:0] D_input;

assign D_input[0] = next_count[0] & ~terminal_count;
assign D_input[1] = next_count[1] & ~terminal_count;
assign D_input[2] = next_count[2] & ~terminal_count;

assign terminal_count = count[2] & ~count[1] & count[0];


    full_adder fa1(
        .A(count[0]),
        .B(1'b1),
        .Cin(1'b0),
        .sum(next_count[0]),
        .Cout(carry[0])
    );
    
    full_adder fa2(
        .A(count[1]),
        .B(1'b0),
        .Cin(carry[0]),
        .sum(next_count[1]),
        .Cout(carry[1])
    );
    
    full_adder fa3(
        .A(count[2]),
        .B(1'b0),
        .Cin(carry[1]),
        .sum(next_count[2])
    );

    d_flipflop dff1(
        .D(D_input[0]),
        .clk(clk),
        .reset(reset),
        .Q(count[0])
    );
    
    d_flipflop dff2(
        .D(D_input[1]),
        .clk(clk),
        .reset(reset),
        .Q(count[1])
    );
    
    d_flipflop dff3(
        .D(D_input[2]),
        .clk(clk),
        .reset(reset),
        .Q(count[2])
    );
    
    
    t_flipflop tff_divider(
        .T(terminal_count),
        .clk(clk),
        .reset(reset),
        .Q(divided_clk)
    );

    
assign led = count;

endmodule

